<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <WavplayMsvcVersion>14.52.37025</WavplayMsvcVersion>
    <VCToolsVersion>$(WavplayMsvcVersion)</VCToolsVersion>
    <BaseOutputPath>$(RepoRoot)out\</BaseOutputPath>
    <BuildFlavor Condition="'$(EnableASAN)' == 'true'">$(Configuration)-ASan</BuildFlavor>
    <BuildFlavor Condition="'$(BuildFlavor)' == ''">$(Configuration)</BuildFlavor>
    <OutDir>$(BaseOutputPath)$(Platform)\$(BuildFlavor)\</OutDir>
    <IntDir>$(BaseOutputPath)obj\$(ProjectName)\$(Platform)\$(BuildFlavor)\</IntDir>
  </PropertyGroup>
</Project>
